{
  "name": "homelab-hub",
  "version": "0.1.0",
  "description": "Self-hosted link dashboard for your homelab with a terminal aesthetic — live status checks, drag & drop, single-container deployment on Kubernetes.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Lukas Koerber",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukislp/homelab-hub.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "server": "DATA_DIR=./data node server/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "bash scripts/smoke.sh",
    "shots": "node scripts/screenshot.mjs",
    "e2e": "node scripts/e2e.mjs",
    "validate:k8s": "bash scripts/validate-k8s.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "js-yaml": "^5.4.1",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
